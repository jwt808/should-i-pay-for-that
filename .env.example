# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
DATABASE_URL="file:./dev.db"

# Admin
ADMIN_PASSWORD=change-me

# Stripe (leave empty for local UI; use DEV_BYPASS_CHECKOUT for E2E)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Local E2E: mark a case paid without Stripe
DEV_BYPASS_CHECKOUT=1

# Optional LLM extraction / draft report (OpenAI-compatible)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Analytics (events fire only when set)
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA_ID=
